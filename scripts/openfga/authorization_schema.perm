// CortexDrive — Permify Authorization Schema
//
// Three access control paradigms in one rule:
//   ReBAC: parent.can_view (composition graph traversal via parent tuples)
//   ABAC:  not check_private(is_private) (node-level privacy exclusion)
//   RBAC:  tenant_viewer via org#member (org membership as implicit role)
//
// Privacy cascade: a node with is_private=true blocks all non-owner access,
// including any child nodes that would inherit via parent.can_view.
// Owner always has unconditional access (first clause of can_view).
//
// depth is supplied at lookup time: LookupEntity(depth=PERMIFY_MAX_DEPTH).
// GLOBAL_MAX_DEPTH=5 covers the full composition hierarchy:
//   Podcast → Episode → Source → Chunk  (4 hops)
//   Company → Project → PreparatoryNote (2 hops)
//   Project → ReferenceLink             (1 hop)

entity user {}

entity org {
    relation member @user
    relation admin  @user
}

entity group {
    relation member @user @org#member
    relation admin  @user
}

entity agent {
    relation delegated_by @user
}

rule check_private(is_private boolean) {
    is_private == true
}

entity node {
    attribute is_private boolean

    // Structural relations
    relation owner          @user
    relation parent         @node                           // written at ingestion for every COMPOSITION_RELATIONSHIP edge
    relation tenant_viewer  @org#member                    // written once per node: org-wide visibility
    relation shared_viewer  @user @group#member @agent     // written once at share time on the root node only

    // non_owner_view: any inherited or directly-granted access, blocked by privacy marker
    permission non_owner_view = (tenant_viewer or shared_viewer or parent.can_view)
                                 and not check_private(is_private)

    // can_view: owner always wins; everyone else goes through privacy check
    permission can_view  = owner or non_owner_view

    // can_share: only the owner may initiate a share
    permission can_share = owner
}
