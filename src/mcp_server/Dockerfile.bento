FROM python:3.11-slim
WORKDIR /app
# constraints-docker.txt locks every version to what production runs (S2-29).
COPY requirements-docker.txt constraints-docker.txt ./
RUN pip install --no-cache-dir -r requirements-docker.txt -c constraints-docker.txt
COPY . .
ENV PORT=8080
EXPOSE 8080
CMD ["python", "cortex_os_mentalmodel_http_server.py"]
