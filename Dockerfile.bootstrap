FROM python:3.11-slim

WORKDIR /app

# Install gcloud CLI (needed for Secret Manager writes in entrypoint)
RUN apt-get update && apt-get install -y curl apt-transport-https gnupg && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list && \
    apt-get update && apt-get install -y google-cloud-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Python deps
COPY src/mcp_server/requirements-docker.txt ./
RUN pip install --no-cache-dir -r requirements-docker.txt python-dotenv

# Copy only what bootstrap needs
COPY src/mcp_server/openfga_utils.py ./src/mcp_server/
COPY scripts/ ./scripts/

RUN chmod +x /app/scripts/openfga_bootstrap_entrypoint.sh

CMD ["/app/scripts/openfga_bootstrap_entrypoint.sh"]
